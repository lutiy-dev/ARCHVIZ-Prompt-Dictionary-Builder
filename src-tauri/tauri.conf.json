{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARCHVIZ Prompt Studio",
  "version": "0.1.0",
  "identifier": "com.ovizlab.archvizpromptstudio",
  "build": {
    "beforeBuildCommand": "node tools/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ARCHVIZ Prompt Studio · LAB",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/ovizlab-mcp"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
