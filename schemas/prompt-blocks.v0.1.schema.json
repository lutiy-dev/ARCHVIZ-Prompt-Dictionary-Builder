{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARCHVIZ Prompt Blocks — schema v0.1 (wire format 1)",
  "$comment": "Compatibility baseline. Only GENERATED is supported until evidence and promotion rules are introduced through an approved schema revision. Cross-reference and template checks are specified in docs/SCHEMA_V0.1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sections",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sections": {
      "const": [
        "GOAL",
        "SOURCE / INPUT",
        "MUST PRESERVE",
        "ALLOWED CHANGES",
        "MATERIAL / SUBJECT",
        "LIGHT / ATMOSPHERE",
        "CAMERA / PHOTOGRAPHY",
        "RESTRICTIONS",
        "QC"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "en",
          "ru",
          "category",
          "section",
          "text",
          "parameters",
          "status",
          "version",
          "conflicts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "en": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ru": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "Geometry",
              "Materials",
              "Lighting",
              "Camera",
              "Atmosphere",
              "Landscape",
              "People",
              "Quality",
              "AI terminology",
              "Negative / Restrictions"
            ]
          },
          "section": {
            "enum": [
              "GOAL",
              "SOURCE / INPUT",
              "MUST PRESERVE",
              "ALLOWED CHANGES",
              "MATERIAL / SUBJECT",
              "LIGHT / ATMOSPHERE",
              "CAMERA / PHOTOGRAPHY",
              "RESTRICTIONS",
              "QC"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 2000
            }
          },
          "status": {
            "const": "GENERATED"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "conflicts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        }
      }
    }
  }
}
